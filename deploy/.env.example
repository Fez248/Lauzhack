# Copy to ../.env (repo root, gitignored) and replace every "changeme". Never commit .env.
# A secret left at "changeme" is live and guessable: replace it, or blank it to get the dev
# behaviour described next to it.

# Database (docker-compose sets DATABASE_URL and DATABASE_USER for the app).
# Leave DATABASE_URL empty when running ./gradlew :server:run: the server then uses an in-memory H2.
DATABASE_URL=
DATABASE_USER=tea
DATABASE_PASSWORD=changeme
# Postgres container password: must be the same value as DATABASE_PASSWORD.
POSTGRES_PASSWORD=changeme

# CORS: exact origins, comma-separated (http://localhost:* and http://127.0.0.1:* are always allowed).
ALLOWED_ORIGINS=https://<org>.github.io
# Base of the web app, used in links inside emails (keep the trailing slash). Empty -> the dev
# default http://localhost:8081/, where ./gradlew :composeApp:wasmJsBrowserDevelopmentRun serves
# the app (its port is pinned to 8081; the API keeps 8080).
APP_PUBLIC_URL=https://<org>.github.io/<repo>/
# This API as reachable from outside (tunnel URL), used for the practice-email link.
API_PUBLIC_URL=https://<tunnel-host>

# Mail. Empty SMTP_PASSWORD -> ConsoleMailer (mails printed to the log, dev only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=ThisIsTea

# Practice email: random delay after the opt-in press, in seconds; scheduler poll interval.
FIELD_DELAY_MIN_S=15
FIELD_DELAY_MAX_S=90
FIELD_POLL_S=5

# Secrets: long random strings (e.g. openssl rand -hex 32).
# ADMIN_KEY empty -> /admin endpoints disabled. CODE_PEPPER empty -> random per start.
ADMIN_KEY=changeme
CODE_PEPPER=changeme

# DEBUG ONLY: a fixed code that /auth/verify accepts in place of the emailed one.
# Unset: "426769" while SMTP_PASSWORD is empty (dev), disabled once SMTP_PASSWORD is set.
# Set to off to disable it always. Never enable it on a public server.
DEV_VERIFY_CODE=

# on | off. off disables the per-email / per-IP limits on /auth (local demos only).
RATE_LIMITS=on
PORT=8080
CONTENT_DIR=content
APP_VERSION=dev

# Optional, offline AI variations only (not used by the server in MVP 0).
OPENROUTER_API_KEY=changeme
